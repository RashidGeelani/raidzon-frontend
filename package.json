    "dexie": "^4.2.0",
    "libphonenumber-js": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "5.0.1",
    "fake-indexeddb": "^6.2.0"
  }
}
